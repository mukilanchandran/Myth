# Copy to .env.local (dev) or set these in your host's build settings (deploy).
# Every value is inlined into the built JS — treat them all as public.

# Product name in the lock screen + notifications
VITE_APP_NAME="Myth"

# Lock-screen password. NOT security — it ships in the bundle in plain text.
VITE_APP_PASSWORD="mukilx"

# OpenAI-compatible AI endpoint. The browser calls this directly, so
# "localhost" means the machine the browser runs on, not the web server.
# For a DEPLOYED app, use a free cloud provider instead (users paste their own
# free API key in Settings → AI brain — never bake a key into this file):
#   Groq (recommended): https://api.groq.com/openai/v1
#   OpenRouter:         https://openrouter.ai/api/v1
#   Google Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
VITE_AI_ENDPOINT="http://localhost:11434/v1"

# Preferred model; leave empty to auto-pick the best installed one.
# e.g. llama3.1:8b (local) · llama-3.3-70b-versatile (Groq)
#      meta-llama/llama-3.3-70b-instruct:free (OpenRouter) · gemini-2.5-flash (Gemini)
VITE_AI_MODEL=""

# Keep the model loaded in RAM so answers start in ~1s instead of ~30s
VITE_AI_WARMUP="true"

# Only for GitHub Pages *project* sites served from a subpath:
# VITE_BASE="/myth/"

# ---- Server-side, Netlify only (Site configuration -> Environment variables) ----
# These are NOT VITE_* values: they never reach the bundle. Set them in the
# Netlify UI, not in this file. See README -> "Cloud storage & sync".
#   MYTH_SYNC_KEY         long passphrase (12+ chars); paste the same in Settings -> Cloud storage
#                         several people on one site: comma-separate several keys
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT   optional, background push (PUSH-SETUP.md)
#   PUSH_TZ_OFFSET_MIN    optional, minutes from UTC for the digest (default 330 = IST)
